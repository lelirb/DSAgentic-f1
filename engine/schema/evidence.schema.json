{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "description": "A single unit of normalized evidence extracted from a Design System. Spec section 13-17.",
  "type": "object",
  "required": ["id", "source", "type", "status", "confidence"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string", "description": "URL or file the evidence came from" },
    "location": { "type": ["string", "null"], "description": "e.g. 'Button > API'" },
    "content": { "type": ["string", "null"] },
    "type": {
      "type": "string",
      "enum": [
        "documentation", "component", "component_api", "component_variant",
        "component_state", "token", "foundation", "pattern", "composition_rule",
        "accessibility", "versioning", "manifest", "schema", "typescript",
        "mcp", "example", "code_example", "restriction", "usage_guideline"
      ]
    },
    "component": { "type": ["string", "null"] },
    "section": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "retrieval_method": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["FOUND", "NOT_FOUND", "NOT_EVALUABLE", "NOT_APPLICABLE"],
      "description": "Section 15-16. These four states must never be conflated."
    },
    "confidence": {
      "type": "number",
      "enum": [1.0, 0.8, 0.6, 0.4],
      "description": "Section 17. Cannot arbitrarily alter score; only affects evaluation if an explicit rule says so."
    }
  }
}
