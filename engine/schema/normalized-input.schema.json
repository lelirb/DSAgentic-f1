{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "normalized-input.schema.json",
  "title": "NormalizedDesignSystemInput",
  "description": "The single input contract for the Evaluator. Produced either by the Extractor (from a crawled URL) or handwritten as a fixture. The Evaluator NEVER reads HTML directly (section 6, 18).",
  "type": "object",
  "required": ["schema_version", "system", "coverage", "evidence", "components", "tokens"],
  "properties": {
    "schema_version": { "type": "string" },
    "methodology_version": { "type": "string" },
    "rules_version": { "type": "string" },

    "system": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },

    "coverage": {
      "type": "object",
      "description": "Section 9-10, 32-33. Denominators must be explicit.",
      "properties": {
        "pages_found": { "type": "integer" },
        "pages_retrieved": { "type": "integer" },
        "pages_failed": { "type": "integer" },
        "components_detected": { "type": "integer" },
        "components_evaluated": { "type": "integer" },
        "crawl_limited": { "type": "boolean", "description": "true if max_pages/max_depth/timeout was hit (section 10)" },
        "evaluation_status": {
          "type": "string",
          "enum": ["COMPLETE", "PARTIAL", "LIMITED"]
        }
      }
    },

    "access": {
      "type": "object",
      "description": "Raw mechanical-access signals feeding D1. Booleans/enums, not scores — scoring happens in the evaluator, not here (section 6).",
      "properties": {
        "documentation_recoverability": {
          "type": "string",
          "enum": ["NOT_RECOVERABLE", "PARTIAL", "MOSTLY_RECOVERABLE", "FULLY_RECOVERABLE"]
        },
        "component_index": {
          "type": "string",
          "enum": ["NONE", "PARTIAL", "MOSTLY", "COMPLETE"]
        },
        "props_types_accessibility": {
          "type": "string",
          "enum": ["NAMES_ONLY", "PARTIAL", "PROPS_AND_TYPES", "PROPS_TYPES_AND_VALUES"]
        },
        "structured_tokens": {
          "type": "string",
          "enum": ["NOT_RECOVERABLE", "PARTIAL", "COMPLETE"]
        },
        "types_or_schema": {
          "type": "string",
          "enum": ["NONE", "PARTIAL", "COMPLETE"]
        },
        "agent_manifest": {
          "type": "string",
          "enum": ["NONE", "PARTIAL", "COMPLETE"]
        },
        "agent_interface": {
          "type": "string",
          "enum": ["NONE", "PRESENT"]
        }
      }
    },

    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "component.schema.json" }
    },
    "tokens": {
      "type": "array",
      "items": { "$ref": "token.schema.json" }
    },
    "foundations": { "type": "array" },
    "patterns": {
      "type": "array",
      "description": "Feeds D5. Each pattern documents a composition of >1 components for a common flow."
    },
    "manifests": { "type": "array" },
    "schemas": { "type": "array" },
    "accessibility": { "type": "array" },

    "documentation": {
      "type": "object",
      "description": "Coverage figures feeding D6. Denominators explicit (section 39).",
      "properties": {
        "components_documented": { "type": "integer" },
        "components_with_code_examples": { "type": "integer" },
        "components_with_executable_examples": { "type": "integer" },
        "components_with_variants_states_explained": { "type": "integer" },
        "versioning_present": { "type": "boolean" }
      }
    },

    "contradictions": {
      "type": "array",
      "description": "Section 38. Detected conflicts between sources. Not resolved automatically.",
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": ["string", "null"] },
          "field": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs into the top-level evidence[] corpus for full traceability (Finding -> Evidence ID -> Evidence -> Source -> Location). Optional for backward compatibility, but required for QA section 18 traceability to hold."
          },
          "values": { "type": "array" }
        }
      }
    },

    "metadata": { "type": "object" }
  }
}
