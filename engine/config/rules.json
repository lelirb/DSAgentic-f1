{
  "rules_version": "0.1",

  "readiness_levels": [
    { "min": 0,  "max": 25,  "label": "Opaco" },
    { "min": 26, "max": 50,  "label": "Legible" },
    { "min": 51, "max": 75,  "label": "Interpretable" },
    { "min": 76, "max": 100, "label": "Operable" }
  ],

  "global_gate": {
    "dimension": "D1",
    "threshold": 25,
    "cap": 40,
    "note": "IF D1 < 25 THEN Global <= 40 (section 31). Gate is applied only when D1 is a numeric FOUND-based score; if D1 itself is NOT_EVALUABLE the report must flag METHODOLOGY_DECISION_REQUIRED instead of silently applying or skipping the gate (see README known-gaps)."
  },

  "partial_evaluation_threshold": 0.5,

  "d1_access": {
    "max": 100,
    "documentation_recoverability": { "max": 15, "NOT_RECOVERABLE": 0, "PARTIAL": 7.5, "MOSTLY_RECOVERABLE": 12, "FULLY_RECOVERABLE": 15 },
    "component_index": { "max": 20, "NONE": 0, "PARTIAL": 10, "MOSTLY": 15, "COMPLETE": 20 },
    "props_types_accessibility": { "max": 20, "NAMES_ONLY": 0, "PARTIAL": 10, "PROPS_AND_TYPES": 15, "PROPS_TYPES_AND_VALUES": 20 },
    "structured_tokens": { "max": 15, "NOT_RECOVERABLE": 0, "PARTIAL": 8, "COMPLETE": 15 },
    "types_or_schema": { "max": 10, "NONE": 0, "PARTIAL": 5, "COMPLETE": 10 },
    "agent_manifest": { "max": 10, "NONE": 0, "PARTIAL": 5, "COMPLETE": 10 },
    "agent_interface": { "max": 10, "NONE": 0, "PRESENT": 10 }
  },

  "d2_foundations": {
    "max": 100,
    "weights": {
      "tokens_identifiable": 10,
      "structured_format": 15,
      "naming_consistency": 15,
      "primitive_to_semantic": 20,
      "color_coverage": 10,
      "spacing_sizing_coverage": 10,
      "typography": 5,
      "other_foundations": 5,
      "modes": 5,
      "intent_documentation": 5
    },
    "no_tokens_found_forces_zero": true
  },

  "d3_components_api": {
    "max": 100,
    "weights": {
      "props_documented": 20,
      "types": 15,
      "allowed_values": 15,
      "defaults": 10,
      "variants": 10,
      "states": 10,
      "api_consistency": 10,
      "prop_purpose": 10
    },
    "props_documented_coverage": [
      { "min_pct": 0.0, "points": 0 },
      { "min_pct": 0.30, "points": 10 },
      { "min_pct": 0.50, "points": 14 },
      { "min_pct": 0.70, "points": 17 },
      { "min_pct": 0.90, "points": 20 }
    ]
  },

  "d4_semantic_clarity": {
    "max": 100,
    "weights": {
      "purpose_identification": 15,
      "component_selection": 25,
      "disambiguation": 20,
      "restrictions": 20,
      "justification": 20
    },
    "note": "Fase 1 measures via documentary/structural evidence only (purpose, when_to_use, when_not_to_use, disambiguation_rules, restrictions present in component.usage). Real Agent Task execution is Fase 2 (section 25)."
  },

  "d5_patterns_composition": {
    "max": 100,
    "weights": {
      "reuse_of_existing_components": 20,
      "composition_rules": 25,
      "hierarchy_nesting": 20,
      "documented_patterns": 20,
      "layout_spacing": 15
    }
  },

  "d6_documentation": {
    "max": 100,
    "weights": {
      "component_coverage": 30,
      "code_examples": 20,
      "executable_examples": 15,
      "variants_states_explained": 15,
      "accessibility": 10,
      "versioning": 10
    },
    "component_coverage_pct": [
      { "min_pct": 0.0, "points": 0 },
      { "min_pct": 0.30, "points": 10 },
      { "min_pct": 0.50, "points": 20 },
      { "min_pct": 0.70, "points": 25 },
      { "min_pct": 0.90, "points": 30 }
    ],
    "code_examples_pct": [
      { "min_pct": 0.0, "points": 0 },
      { "min_pct": 0.30, "points": 7 },
      { "min_pct": 0.50, "points": 12 },
      { "min_pct": 0.70, "points": 16 },
      { "min_pct": 0.90, "points": 20 }
    ],
    "executable_examples_pct": [
      { "min_pct": 0.0, "points": 0 },
      { "min_pct": 0.0000001, "points": 5 },
      { "min_pct": 0.30, "points": 10 },
      { "min_pct": 0.70, "points": 15 }
    ]
  },

  "d7_design_code_consistency": {
    "status": "NOT_EVALUATED",
    "message": "No evaluado — requiere conexión a Figma."
  }
}
